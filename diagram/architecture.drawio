          <mxGeometry x="1090" y="766" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="swapnote" value="&lt;b&gt;Verify count &#8594; atomic alias swap&lt;/b&gt;&lt;br&gt;POST /_aliases { remove: v3, add: v4 }&lt;br&gt;&lt;font color=&quot;#8B94A0&quot;&gt;v3 retained 7 days &#8212; rollback is&lt;br&gt;one alias action&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;arcSize=10;" vertex="1" parent="1">
