        </mxCell>
        <mxCell id="aliasnote" value="&lt;b&gt;alias:&lt;/b&gt; products &#8594; products-v{N}&lt;br&gt;&lt;font color=&quot;#8B94A0&quot;&gt;all traffic addresses the alias,&lt;br&gt;never the concrete index&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D8102;dashed=1;fontSize=9;fontColor=#232F3E;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="470" width="170" height="62" as="geometry" />
        </mxCell>
        <mxCell id="disposablenote" value="&#9733; &lt;b&gt;The read model is disposable&lt;/b&gt;&lt;br&gt;No authoritative data lives here.&lt;br&gt;Node loss, corruption, bad mapping&lt;br&gt;&#8212; all recover by rebuilding from &#9319;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF9F3;strokeColor=#1D8102;strokeWidth=1.5;fontSize=9;fontColor=#146600;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="560" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- ============ VPC NOTE ============ -->
        <mxCell id="vpcnote" value="&lt;b&gt;VPC &#183; private subnets&lt;/b&gt; &#8212; Indexer Lambda, Search Lambda and the OpenSearch domain have &lt;b&gt;no public endpoint&lt;/b&gt;.&lt;br&gt;Gateway VPC Endpoints (DynamoDB, S3) are &lt;b&gt;free&lt;/b&gt; &#183; &lt;b&gt;NO NAT Gateway&lt;/b&gt; &#8212; the functions need no internet route." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;dashed=1;fontSize=10;fontColor=#232F3E;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1105" y="490" width="390" height="66" as="geometry" />
        </mxCell>

        <!-- ============ GROUP 8 : REINDEX ============ -->
        <mxCell id="g8" value="&#9319;&#160;REINDEX PIPELINE  &#8212; zero downtime, zero table read capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#E7157B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#B00E5E;arcSize=6;" vertex="1" parent="1">
