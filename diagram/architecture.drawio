        <!-- ============ CONSISTENCY CONTRACT CALLOUT ============ -->
        <mxCell id="contract" value="&lt;b&gt;Consistency contract&lt;/b&gt;&lt;br&gt;Seller reads own product &#8594; &lt;b&gt;DynamoDB, strong&lt;/b&gt; (flow 9)&lt;br&gt;Buyer searches catalog &#8594; &lt;b&gt;OpenSearch, eventual, p95 &lt; 5 s&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8B94A0&quot;&gt;published to clients in the X-Index-Lag-Ms header&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#B8860B;strokeWidth=1.5;fontSize=10;fontColor=#232F3E;arcSize=8;align=left;spacingLeft=10;" vertex="1" parent="1">
