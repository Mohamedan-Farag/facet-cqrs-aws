        <mxCell id="indexer" value="Lambda — Indexer&#10;transform + _bulk" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1370" y="196" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="esmnote" value="&lt;b&gt;Event source mapping&lt;/b&gt;&lt;br&gt;BatchSize 100 &#183; window 5 s&lt;br&gt;ParallelizationFactor 10&lt;br&gt;BisectBatchOnFunctionError&lt;br&gt;ReportBatchItemFailures&lt;br&gt;MaxRetry 3 &#183; MaxAge 3600 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;dashed=1;fontSize=9;align=left;spacingLeft=8;fontColor=#232F3E;arcSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1140" y="322" width="180" height="96" as="geometry" />
        </mxCell>
